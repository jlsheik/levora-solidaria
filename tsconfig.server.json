{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "dist-server",
    "noEmit": false,
    "jsx": "react-jsx"
  },
  "include": ["src/endpoints", "src/helpers", "server", "db"],
  "exclude": [
    "node_modules",
    "dist",
    "dist-server",
    "src/helpers/useScrollReveal.tsx",
    "src/helpers/useIsMobile.tsx",
    "src/helpers/useMediaQuery.tsx",
    "src/helpers/useAuth.tsx",
    "src/helpers/themeMode.tsx",
    "src/helpers/connectorsManual.tsx",
    "src/helpers/connectorsTypes.tsx"
  ]
}
