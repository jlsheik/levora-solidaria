# Levora Solidária — variáveis de ambiente
# Copie para .env e preencha. Nunca commitar o .env real.

# Postgres (obrigatório)
DATABASE_URL=postgres://usuario:senha@localhost:5432/levora_solidaria

# Autenticação (obrigatório) — string aleatória longa usada para assinar os
# tokens de sessão (JWT). Gere uma com: openssl rand -base64 48
JWT_SECRET=

# Porta do servidor de API (opcional, default 3001)
PORT=3001

# IA de apoio ao motor de correspondência (opcional — sem isso o sistema
# continua funcionando normalmente, só com o escore determinístico por
# palavra-chave, sem o apoio semântico da IA; ver src/helpers/aiClient.tsx)
ANTHROPIC_API_KEY=
LEVORA_AI_MODEL=claude-haiku-4-5-20251001

# E-mail (opcional — usado para enviar convites de membro por e-mail; ver
# src/helpers/emailAdapter.tsx). Sem isto configurado, convites continuam
# funcionando normalmente: o link é devolvido na resposta da API para quem
# convidou compartilhar manualmente, mas nenhum e-mail é enviado de verdade
# (a interface nunca finge que enviou).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Levora Solidária <nao-responda@example.org>"

# URL pública do cliente (usada para montar o link de aceite de convite no
# e-mail, ex.: https://app.levorasolidaria.org.br). Em desenvolvimento, o
# padrão já aponta para o Vite local.
APP_PUBLIC_URL=http://localhost:5173

# Armazenamento de arquivos (comprovantes de entrega etc.). Por padrão usa
# disco local (STORAGE_LOCAL_DIR, padrão "storage/uploads", fora de
# qualquer diretório servido publicamente) — funciona sem nenhuma
# configuração. Para usar um bucket S3-compatível (AWS S3, Cloudflare R2,
# MinIO) em vez de disco local, preencha as 4 variáveis abaixo
# (S3_ENDPOINT só é necessário para R2/MinIO, não para AWS S3):
STORAGE_LOCAL_DIR=storage/uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Quantos dias um pedido de dupla autorização (approval_requests) pode
# ficar pendente antes de expirar automaticamente (ver
# src/helpers/expireApprovalRequests.tsx e src/helpers/scheduler.tsx).
APPROVAL_REQUEST_EXPIRATION_DAYS=7

# Só necessário em produção, atrás de um proxy reverso/load balancer real
# (nginx, Cloudflare, etc.) — diga quantos saltos de proxy confiar para que
# o IP do cliente seja lido corretamente de X-Forwarded-For (usado pelo
# rate limiting, ver src/helpers/rateLimit.tsx). Deixe em branco em
# desenvolvimento local.
TRUST_PROXY=

# --- Identidade / MFA (Fase 90). SEGREDOS: gere valores aleatórios e NUNCA os versione. ---
# Pepper do HMAC de segredos bearer (recovery codes, token de bootstrap, challenges). >= 32 bytes. Versionado: V1, V2...
IDENTITY_CODE_PEPPER_V1=
IDENTITY_CODE_PEPPER_CURRENT=1
# Chave AES-256-GCM do segredo TOTP: 32 bytes em base64 (ex.: openssl rand -base64 32). Versionada: V1, V2...
MFA_ENCRYPTION_KEY_V1=
MFA_ENCRYPTION_KEY_CURRENT=1
# MFA obrigatório para titulares de platform_access. 'false' só vale com LEVORA_ENVIRONMENT=staging (seed sintético).
PLATFORM_MFA_REQUIRED=true

# --- Login/cadastro com Google (Fase 92). SEGREDOS: nunca versione valores reais. ---
# Credenciais do cliente OAuth "Aplicativo da Web" criado no Google Cloud Console (ver docs/IDENTIDADE_FASE92_GOOGLE_AUDITORIA.md §13).
# O redirect URI tem de ser EXATAMENTE um dos "URIs de redirecionamento autorizados" do cliente. Nunca é montado a partir de Host.
#   desenvolvimento: http://localhost:5173/_api/v1/auth/google-callback   (o proxy do Vite repassa /_api para a API)
#   staging/produção: https://<dominio-publico>/_api/v1/auth/google-callback   (HTTPS obrigatório fora de localhost)
# Sem estas três variáveis o botão "Google" responde "não disponível neste ambiente" e nada é criado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Opcional (padrão: Discovery oficial do Google). Os endpoints descobertos têm de ser HTTPS em domínios do Google.
# GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
