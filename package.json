{
  "name": "levora-solidaria",
  "version": "1.0.0",
  "private": true,
  "description": "Levora Solidária — infraestrutura autônoma de captação, validação, logística, distribuição e prestação de contas de doações. Portado do Floot para um stack padrão Node/Express/Postgres.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-server-assets.cjs",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "qa:visual": "node scripts/qa-visual/run.mjs",
    "db:migrate": "tsx db/migrate.ts",
    "db:migrate:incremental": "tsx db/run-migrations.ts",
    "seed:staging": "node dist-server/db/seed-staging.js",
    "client:dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-context-menu": "^2.2.4",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-hover-card": "^1.1.4",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toggle": "^1.1.1",
    "@radix-ui/react-toggle-group": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-query": "^5.62.0",
    "bcryptjs": "^3.0.3",
    "cmdk": "^1.0.4",
    "cookie": "^1.0.2",
    "dotenv": "^16.4.5",
    "embla-carousel": "^8.5.1",
    "embla-carousel-react": "^8.5.1",
    "express": "^4.21.1",
    "jose": "^6.2.12",
    "kysely": "^0.29.0",
    "kysely-postgres-js": "^5.0.0",
    "lucide-react": "^0.469.0",
    "nanoid": "^6.0.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-day-picker": "^9.4.4",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.0",
    "sonner": "^1.7.1",
    "superjson": "^2.2.2",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^5.0.1"
  }
}
